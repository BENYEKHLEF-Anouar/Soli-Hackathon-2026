%% RELATIONS

User "1" --> "many" ShoppingList : creates
ShoppingList "1" --> "many" Item : contains

ShoppingList "1" --> "1" OptimizationResult : generates
OptimizationResult "1" --> "many" OptimizationOption : includes

OptimizationOption "many" --> "many" Store : uses
Store "1" --> "many" PriceEntry : publishes

User "1" --> "many" Deal : submits
Deal "many" --> "1" Store : occurs_at

Deal "1" --> "1" MapPin : visualized_as

User "1" --> "many" TicketScan : uploads
TicketScan "1" --> "many" Deal : generates_or_validates

User "1" --> "many" Notification : receives

User "1" --> "many" PointsTransaction : earns
User "1" --> "many" Badge : unlocks

User "1" --> "many" LeaderboardEntry : ranked_in

Store "1" --> "1" Location : located_at
MapPin "1" --> "1" Location : placed_on